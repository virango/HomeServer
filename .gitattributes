# Set the default behavior, in case people don't have core.autocrlf set.
* text eol=lf

# Explicitly declare text files you want to always be normalized and converted
# to native line endings on checkout.
*.c text
*.h text

# Declare files that will always have LF line endings on checkout.
*.sln text
*.bat text
*.cmd text

# Denote all files that are truly binary and should not be modified.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.mov binary
*.mp4 binary
*.mp3 binary
*.flv binary
*.fla binary
*.swf binary
*.gz binary
*.zip binary
*.7z binary
*.ttf binary
*.eot binary
*.woff binary
*.woff2 binary
*.pyc binary
*.pdf binary

# Text files
*.md text
*.py text
*.yml text
*.yaml text
*.json text
*.txt text
*.sh text eol=lf
*.bat text
*.cmd text

# Docker files
Dockerfile text
docker-compose.yml text
docker-compose.yaml text

# Configuration files
*.conf text
*.ini text
*.cfg text