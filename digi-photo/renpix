#!/usr/bin/env python3
import argparse
import subprocess
from pathlib import Path

SCRIPT_DIR = Path(__file__).resolve().parent
CONFIG_FILE = SCRIPT_DIR / ".ExifTool_config"
HOME_CONFIG_FILE = Path.home() / ".ExifTool_config"


def get_config_file():
    """Find the .ExifTool_config file with fallback logic."""
    if CONFIG_FILE.exists():
        return CONFIG_FILE
    if HOME_CONFIG_FILE.exists():
        return HOME_CONFIG_FILE
    return None

EXPR_BY_EXT = {
    ".cr2": "-FileName<${CreateDate}-$MyRawFileNumber.cr2",
    ".cr3": "-FileName<${CreateDate}-$MyRawFileNumber.cr3",
    ".jpg": "-FileName<${CreateDate}-$MyFileNameNumber.jpg",
    ".mov": "-FileName<${CreateDate}-$MyMovFileNumber.mov",
}
DEFAULT_PATTERNS = ["*.cr2", "*.CR2", "*.cr3", "*.CR3", "*.jpg", "*.JPG", "*.mov", "*.MOV"]


def build_groups(paths):
    groups = {}
    for path in paths:
        ext = path.suffix.lower()
        expr = EXPR_BY_EXT.get(ext)
        if expr is None:
            print(f"Warning: unsupported extension for '{path.name}', skipping.")
            continue
        groups.setdefault(expr, []).append(str(path))
    return groups


def run_renpix(paths=None):
    if paths:
        groups = build_groups(paths)
    else:
        # Expand glob patterns to actual files
        expanded_paths = []
        for pattern in DEFAULT_PATTERNS:
            expanded_paths.extend(Path(".").glob(pattern))
        groups = build_groups(expanded_paths)

    if not groups:
        print("Nothing to rename.")
        return 0

    config_file = get_config_file()
    result = 0
    for expr, items in groups.items():
        command = ["exiftool"]
        if config_file:
            command.extend(["-config", str(config_file)])
        command.extend(["-P", "-v", expr, "-d", "%Y%m%d_%H%M"] + items)
        print("Running:", " ".join(command))
        completed = subprocess.run(command)
        if completed.returncode != 0:
            result = completed.returncode
    return result


def parse_args():
    parser = argparse.ArgumentParser(
        description="Rename image and video files by EXIF/CreateDate using exiftool."
    )
    parser.add_argument(
        "files",
        nargs="*",
        help="Optional file paths to rename. If omitted, all supported files in the current directory are renamed.",
    )
    return parser.parse_args()


def main():
    args = parse_args()
    paths = [Path(p) for p in args.files] if args.files else None
    return_code = run_renpix(paths)
    raise SystemExit(return_code)


if __name__ == "__main__":
    main()
